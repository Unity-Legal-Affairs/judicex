# Copy to /etc/rahimi-assistant.env and replace all example values.
# Generate with: openssl rand -hex 32
JUDICEX_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
JUDICEX_DB_PATH=/var/lib/rahimi-assistant/rahimi.db
JUDICEX_DEFAULT_AREA=iran
JUDICEX_SESSION_COOKIE_SECURE=1

# Optional: configure a local Ollama endpoint only if Ollama is installed
# on this same server. Do not send client files to hosted LLM APIs unless
# the data-processing and confidentiality implications have been reviewed.
JUDICEX_OLLAMA_HOST=http://127.0.0.1:11434
