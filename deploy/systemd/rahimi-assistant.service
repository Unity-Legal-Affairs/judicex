[Unit]
Description=Rahimi Legal Assistant (private Judicex instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rahimi-assistant
Group=rahimi-assistant
WorkingDirectory=/opt/rahimi-assistant
EnvironmentFile=/etc/rahimi-assistant.env
ExecStart=/opt/rahimi-assistant/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 180 --bind 127.0.0.1:5051 --access-logfile - --error-logfile - "judicex_memory_os.web_app:create_server_app()"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rahimi-assistant

[Install]
WantedBy=multi-user.target
